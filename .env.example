# Copy to .env (untracked) and fill in. docker compose reads .env from this folder.
# JWT_SECRET:   openssl rand -base64 48
# VAPID keys:   node -e "console.log(require('web-push').generateVAPIDKeys())"
JWT_SECRET=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Required SQLite directory on the Docker host. Use an existing directory.
BESMART_DB_DIR=
# Optional SQLite filename. Defaults to besmart.db.
# BESMART_DB_FILENAME=besmart.db
